{
  "expo": {
    "name": "Einsdream",
    "slug": "einsdream-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F1218",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "cl.einsdream.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0F1218"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Permite a Einsdream grabar sonidos durante la noche para detectar y clasificar interrupciones acústicas."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "einsdream-mobile"
      }
    }
  }
}
